#VRML_SIM R2025a utf8

WorldInfo {
  title "Garbage Sorting Robot"
  basicTimeStep 32
}

Viewpoint {
  orientation -0.3 0.8 0.5 1.2
  position 0 2.5 3.5
}

Background {
  skyColor [0.1 0.1 0.15]
}

DirectionalLight {
  ambientIntensity 0.5
  direction -1 -1 -1
  intensity 1.5
}

# Floor
DEF FLOOR Solid {
  translation 0 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.3 0.3 0.3
        roughness 1
      }
      geometry Box {
        size 3 0.02 2
      }
    }
  ]
  boundingObject Box {
    size 3 0.02 2
  }
}

# Pick point platform (where items appear)
DEF PICK_PLATFORM Solid {
  translation 0 0.06 0.5
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.8 0.8
        roughness 0.5
      }
      geometry Box {
        size 0.3 0.1 0.3
      }
    }
  ]
  boundingObject Box {
    size 0.3 0.1 0.3
  }
}

# ── 5 Bins ─────────────────────────────────────────────────────────────────

# Bin 1 - wet_organic (green)
DEF BIN_WET Solid {
  translation -1.1 0.1 -0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.7 0.1 }
      geometry Box { size 0.25 0.2 0.25 }
    }
    Transform {
      translation 0 0.18 0
      children [
        Shape {
          appearance PBRAppearance { baseColor 1 1 1 }
          geometry Box { size 0.24 0.05 0.05 }
        }
      ]
    }
  ]
  boundingObject Box { size 0.25 0.2 0.25 }
}

# Bin 2 - recyclable_plastic (blue)
DEF BIN_PLASTIC Solid {
  translation -0.55 0.1 -0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.3 0.9 }
      geometry Box { size 0.25 0.2 0.25 }
    }
  ]
  boundingObject Box { size 0.25 0.2 0.25 }
}

# Bin 3 - hazardous (red)
DEF BIN_HAZARDOUS Solid {
  translation 0 0.1 -0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.1 0.1 }
      geometry Box { size 0.25 0.2 0.25 }
    }
  ]
  boundingObject Box { size 0.25 0.2 0.25 }
}

# Bin 4 - health_medical (white)
DEF BIN_MEDICAL Solid {
  translation 0.55 0.1 -0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.95 0.95 }
      geometry Box { size 0.25 0.2 0.25 }
    }
  ]
  boundingObject Box { size 0.25 0.2 0.25 }
}

# Bin 5 - glass_metal (yellow)
DEF BIN_GLASS Solid {
  translation 1.1 0.1 -0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.8 0.1 }
      geometry Box { size 0.25 0.2 0.25 }
    }
  ]
  boundingObject Box { size 0.25 0.2 0.25 }
}

# ── Robot Arm (KUKA KR 210) ────────────────────────────────────────────────
KUKA_KR210L150 {
  translation 0 0.02 0
  rotation 0 1 0 0
  controller "sorting_robot"
}

# ── Camera above pick point ────────────────────────────────────────────────
DEF OVERHEAD_CAMERA Solid {
  translation 0 0.8 0.5
  rotation 1 0 0 -1.5708
  children [
    Camera {
      width 224
      height 224
      fieldOfView 0.8
    }
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.2 0.2 }
      geometry Box { size 0.05 0.05 0.05 }
    }
  ]
}